# MCP Notify Environment Variables
# Copy this file to .env and customize

# Database (required)
MCP_WATCH_DATABASE_URL=postgres://user:password@localhost:5432/mcp_watch?sslmode=disable

# Redis (optional, for caching)
MCP_WATCH_REDIS_URL=redis://localhost:6379/0

# Server
MCP_WATCH_SERVER_HOST=0.0.0.0
MCP_WATCH_SERVER_PORT=8080

# Registry
MCP_WATCH_REGISTRY_URL=https://registry.modelcontextprotocol.io
MCP_WATCH_REGISTRY_POLL_INTERVAL=5m

# Logging
MCP_WATCH_LOG_LEVEL=info
MCP_WATCH_ENV=development

# Email (SMTP)
MCP_WATCH_SMTP_HOST=smtp.example.com
MCP_WATCH_SMTP_PORT=587
MCP_WATCH_SMTP_USERNAME=
MCP_WATCH_SMTP_PASSWORD=
MCP_WATCH_SMTP_FROM=mcp-watch@example.com

# Telemetry
MCP_WATCH_METRICS_ENABLED=true
MCP_WATCH_METRICS_PORT=9090
MCP_WATCH_TRACING_ENABLED=false
